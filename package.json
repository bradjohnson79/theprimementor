{
  "name": "wisdom-transmissions",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @wisdom/web dev",
    "dev:api": "pnpm --filter @wisdom/api dev",
    "dev:admin": "pnpm --filter @wisdom/admin dev",
    "build:web": "pnpm --filter @wisdom/web build",
    "build:api": "pnpm --filter @wisdom/api build",
    "build:admin": "pnpm --filter @wisdom/admin build",
    "db:generate": "pnpm --filter @wisdom/db generate",
    "db:migrate": "pnpm --filter @wisdom/db migrate",
    "db:studio": "pnpm --filter @wisdom/db studio",
    "db:seed-admin": "pnpm --filter @wisdom/db seed-admin --",
    "db:seed-shop": "pnpm --filter @wisdom/db seed-shop",
    "stripe:backfill": "pnpm --filter @wisdom/api stripe:backfill --",
    "stripe:backfill:dry-run": "pnpm --filter @wisdom/api stripe:backfill:dry-run",
    "reconcile:stripe": "pnpm --filter @wisdom/api reconcile:stripe --",
    "validate:session-catalog": "pnpm --filter @wisdom/api validate:session-catalog",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test:e2e:shop": "playwright test",
    "test:e2e:shop-success": "playwright test -c playwright.shop-success.config.ts",
    "test:e2e:admin": "playwright test -c playwright.admin.config.ts"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@9.15.4",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.0.3",
    "prettier": "^3.8.1",
    "@playwright/test": "^1.55.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1"
  }
}
